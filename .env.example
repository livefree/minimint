# mini-mint environment template
# Copy to .env.local (gitignored) and fill values.

# ── Database ────────────────────────────────────────────────────────
# Neon Postgres connection string. Get from Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────
# Bcrypt-hashed operator password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
APP_PASSWORD_HASH=

# 32+ bytes hex for JWT signing. Generate with:
#   openssl rand -hex 64
SESSION_SECRET=

# Cookie name + max-age — usually leave defaults.
SESSION_COOKIE_NAME=mm.session
SESSION_MAX_AGE_SECONDS=2592000   # 30 days

# ── Market data ─────────────────────────────────────────────────────
# Finnhub free tier API key. https://finnhub.io
FINNHUB_API_KEY=

# Optional: encrypt the Finnhub key in app_settings using this AES-GCM secret
# (32-byte hex). If unset, the key is stored plaintext in the DB row.
SECRETS_KEY=

# ── App behavior ────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=mini-mint

# Refresh cadence in seconds for live quote polling during market hours.
QUOTE_REFRESH_SECONDS=30

# ── Dev only ────────────────────────────────────────────────────────
# Set to "true" to seed mock profiles + accounts + transactions for design parity.
DEMO_MODE=false
