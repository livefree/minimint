# OS
.DS_Store
Thumbs.db

# Node
node_modules/
.pnp.*
.yarn/

# Next.js
.next/
out/
next-env.d.ts

# Build
build/
dist/

# Env (templates kept; secrets ignored)
.env
.env.local
.env.*.local

# Claude Code per-user local settings (project settings.json IS committed)
.claude/settings.local.json
.claude/.session/

# Logs (keep structure dirs, ignore content)
logs/agents/*
logs/audits/*
logs/dev/*
!logs/**/.gitkeep
!logs/README.md
!logs/ledger/CHANGELOG.md
!logs/ledger/decisions.ndjson

# Test artifacts
coverage/
playwright-report/
test-results/

# Editor
.vscode/
.idea/
*.swp

# Drizzle journal (committed by some teams; we keep generated SQL only)
# db/migrations/meta/ IS tracked — drizzle-kit reads _journal.json and
# snapshot files to compute the next migration. Losing these would
# break `pnpm db:generate` cohesion across machines.

# Misc
*.log
.pnpm-debug.log*
.turbo/
tsconfig.tsbuildinfo

# Probe artifacts — large JSON snapshots; commit only ANALYSIS.md
logs/probes/*-AAPL-*.json
logs/probes/*-MSFT-*.json
logs/probes/*-SPY-*.json
logs/probes/*-GOOGL-*.json
logs/probes/*-SEARCH-*.json
logs/probes/*_summary.json
